# Copy to .env for local dev (do NOT commit real values). On Cloud Run set these
# as service env vars or (for secrets) via Secret Manager.

# Google Cloud project (Datastore lives here). Usually set automatically on GCP.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Shared token that Cloud Scheduler must send to trigger the crawl (X-Crawl-Token
# header) when NOT using OIDC. Generate a long random string.
CRAWL_TOKEN=change-me-to-a-long-random-string

# Google Sheet (CSV export) providing the account roster for Prospect triggers.
# Columns: Account Name, Account Owner, Website. Share = anyone with link (viewer).
ROSTER_SHEET_URL=https://docs.google.com/spreadsheets/d/1Huefbi603aG5lNfJjQHiIcBXCEnEXPpotmElNfcUh9A/export?format=csv&gid=0

# GNews.io free API key for the HQ/UK news-watch (optional — news is empty without it).
GNEWS_API_KEY=

# SendGrid for the daily digest email (optional — skipped if unset).
SENDGRID_API_KEY=
EMAIL_FROM=alerts@thesqua.re
EMAIL_TO=you@thesqua.re
EMAIL_MODE=changes-only   # or "always"

# Max GOV.UK decision detail fetches per crawl (delta-safe; higher = slower first run).
DETAIL_CAP=40
